{
  "manifest_version": 3,
  "name": "Late-Meet",
  "version": "1.0.0",
  "description": "Privacy-first AI meeting copilot for Google Meet with real-time transcription and late-joiner summaries.",
  "permissions": [
    "alarms",
    "commands",
    "offscreen",
    "sidePanel",
    "storage",
    "tabCapture",
    "tabs"
  ],
  "host_permissions": [
    "https://meet.google.com/*"
  ],
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Late Meet"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
